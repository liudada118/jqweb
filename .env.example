# ============================================
# 柜侨工业官网 - 环境变量配置
# ============================================

# ---- 必填项 ----

# Payload CMS 密钥（用于加密 session，生产环境请使用随机强密码）
PAYLOAD_SECRET=your-strong-secret-key-here

# SQLite 数据库连接 URL
# 本地开发：file:./guiqiao-payload.db
# Turso 云端：libsql://your-db-name-your-org.turso.io
SQLITE_URL=file:./guiqiao-payload.db

# Turso 数据库认证 Token（仅使用 Turso 时需要）
SQLITE_AUTH_TOKEN=

# ---- 可选项 ----

# 网站公开 URL（Vercel 部署时自动设置，无需手动配置）
# NEXT_PUBLIC_SERVER_URL=https://your-domain.com

# 端口号（本地开发用，默认 3001）
PORT=3001

# Cron 任务密钥（用于保护定时任务 API）
# CRON_SECRET=your-cron-secret
